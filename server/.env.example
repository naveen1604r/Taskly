# ==============================================================================
# Taskly Backend Environment Configuration Template
# Copy this file to server/.env and fill in your actual values.
# NEVER commit server/.env to version control!
# ==============================================================================

# Server Environment
# Options: 'development', 'production', 'test'
NODE_ENV=development

# Server Port (In production hosting like Render, PORT is dynamically injected automatically)
PORT=5000

# Client URL for CORS Whitelisting
# Development: http://localhost:5173
# Production (Netlify): https://your-taskly-frontend.netlify.app (without trailing slash)
# Multiple origins can be comma-separated: https://your-taskly-frontend.netlify.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration (Render cannot access localhost MySQL; use cloud MySQL such as Aiven, TiDB Cloud, PlanetScale, or Railway)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taskly
DB_USER=root
DB_PASSWORD=

# Database SSL (Optional: auto-enabled for remote DBs in production, set to true if provider mandates SSL)
DB_SSL=true

# JWT Authentication
# In production, use a high-entropy cryptographically random secret of at least 32 characters
# Example generator: openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_production_secret_key_at_least_32_characters
JWT_EXPIRES_IN=7d
